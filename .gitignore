/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
#/build

dist/

/build/*
/.vscode
/.idea
/.claude
/.superpowers
/.playwright-mcp

# npm lockfile artifact (this repo ships yarn.lock)
package-lock.json

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
#.env

npm-debug.log*
yarn-debug.log*
yarn-error.log*
config.js*
rewrite.sh
bfg.jar
kookit.js
kookit.mjs
kookit-extra.js
kookit-extra.mjs
kookit-extra-browser.js
kookit-extra-browser.mjs

# Android build outputs & local secrets
android/local.properties
android/.gradle/
android/.idea/
android/app/build/
android/build/
android/engine/*/build/
android/core/*/build/
android/feature/*/build/
android/feature/build/
android/benchmarks/build/
# KSP / kapt 编译中间产物（镜像源码结构的 .kt 副本，非源文件）
android/engine/*/bin/
android/core/*/bin/
android/feature/*/bin/
android/keystore/
*.keystore
# agent scratch（临时 commit-message 等）
.review/

# Staged web build (build output, regenerated by scripts/build-android.js)
android/app/src/main/assets/webapp/

# Local Gradle user home used by sandboxed agent builds (not the wrapper default)
.gradle-home/
