<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      No storage permissions, by design: every import path is permission-free.
      `content://` intents carry a system read grant; in-app pickers use the
      Storage Access Framework. Direct `file://` reads are not supported under
      scoped storage — when such an intent fails, the shell shows a guiding
      toast instead.
    -->

    <application
        android:name=".KoodoReaderApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.KoodoReader">

        <!--
          P8: Macrobenchmark (android/benchmarks) profiles the app through
          `am profile start`, which Android 10+ only allows for a debuggable or
          `<profileable>` app. This grants shell profiling ONLY — it does not make
          the app debuggable, and it is ignored below API 29.
          Measurement entry point: scripts/ci-macro-benchmark.sh
        -->
        <profileable android:shell="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustResize">

            <!-- Deep link for the koodo-reader:// scheme. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="koodo-reader" />
            </intent-filter>

            <!--
              Open ebooks from other apps (file managers, browsers, mail).
              MIME list mirrors the official Android build so "Open with" works
              for every format the app supports.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/epub+zip" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <data android:scheme="content" android:mimeType="text/html" />
                <data android:scheme="content" android:mimeType="application/xhtml+xml" />
                <data android:scheme="content" android:mimeType="text/xml" />
                <data android:scheme="content" android:mimeType="application/xml" />
                <data android:scheme="content" android:mimeType="text/markdown" />
                <data android:scheme="content" android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:scheme="content" android:mimeType="application/x-mobipocket-ebook" />
                <data android:scheme="content" android:mimeType="application/x-fictionbook+xml" />
                <data android:scheme="content" android:mimeType="message/rfc822" />
                <data android:scheme="content" android:mimeType="application/x-cbz" />
                <data android:scheme="content" android:mimeType="application/x-cbr" />
                <data android:scheme="content" android:mimeType="application/x-cbt" />
                <data android:scheme="content" android:mimeType="application/x-cb7" />
                <data android:scheme="file" android:mimeType="application/epub+zip" />
                <data android:scheme="file" android:mimeType="application/pdf" />
                <data android:scheme="file" android:mimeType="text/plain" />
                <data android:scheme="file" android:mimeType="text/html" />
                <data android:scheme="file" android:mimeType="application/xhtml+xml" />
                <data android:scheme="file" android:mimeType="text/xml" />
                <data android:scheme="file" android:mimeType="text/markdown" />
                <data android:scheme="file" android:mimeType="application/x-mobipocket-ebook" />
                <data android:scheme="file" android:mimeType="application/x-fictionbook+xml" />
                <data android:scheme="file" android:mimeType="application/x-cbz" />
                <data android:scheme="file" android:mimeType="application/x-cbr" />
                <data android:scheme="file" android:mimeType="application/x-cbt" />
                <data android:scheme="file" android:mimeType="application/x-cb7" />
            </intent-filter>

            <!-- Share sheet target ("Send to Koodo Reader"). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!--
              Some file managers report `file://` URIs with a generic MIME type.
              Kept in its own filter so `application/octet-stream` does not widen
              the content:// and share-sheet matches above.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!--
          Native shell (Compose, P1): bookshelf + reader placeholder. It is the
          launcher activity only for `-Ptarget=native` builds — the launcher
          entry is the activity-alias below whose target is selected by the
          `nativeLauncher` manifest placeholder (see app/build.gradle).
          VIEW/SEND intent filters stay on MainActivity for now: opening books
          from other apps still lands in the WebView track until the native
          import pipeline (P1) and reader (P2) land.
        -->
        <activity
            android:name=".shell.NativeShellActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density"
            android:theme="@style/Theme.KoodoReader" />

        <activity-alias
            android:name=".LauncherAlias"
            android:targetActivity="${nativeLauncher}"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          P3: the native PDF reader's "share current page" exports a PNG into
          `cacheDir/pdf-shots/` and hands it to the share sheet. The cache lives
          inside the app sandbox, so a FileProvider is the only way another app
          can read it. The authority is app-id-scoped to stay unique per build
          type (see res/xml/file_paths.xml for the exposed subtree).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
