+package com.koodoreader.core.data.entity
+
+import androidx.room.ColumnInfo
+import androidx.room.Entity
+import androidx.room.Index
+import androidx.room.PrimaryKey
+
+/**
+ * Selection-translation history (`translation_history`).
+ *
+ * Android-owned table (no desktop `schema.lock` counterpart — the desktop
+ * keeps translation results in the plugin cache, not in SQLite). Merged from
+ * `:feature:translate` into `KoodoDatabase` by P6-TRANS-DB (t-mufbb7du) as a
+ * pure additive `CREATE TABLE` migration (version 1 → 2, see
+ * `KoodoMigrations.MIGRATION_1_2`); the three indices mirror the upstream
+ * query paths (recent / per-book / per-provider).
+ */
+@Entity(
+    tableName = "translation_history",
+    indices = [
+        Index(value = ["createdAt"]),
+        Index(value = ["bookKey"]),
