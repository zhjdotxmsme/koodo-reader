+package com.koodoreader.core.data
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import java.sql.Connection
+import java.sql.DriverManager
+
+/**
+ * P6-TRANS-DB migration tests (acceptance [2]): replay `MIGRATION_1_2`'s DDL
+ * on real SQLite (sqlite-jdbc, in-memory) and verify —
+ *  - the `translation_history` table + 3 indices exist after the migration,
+ *  - v1 data in the pre-existing desktop tables survives verbatim,
+ *  - rows round-trip through the migrated table (empty / populated / bulk),
+ *  - the migrated schema matches Room's own expectation (columns + order as
+ *    exported in `schemas/com.koodoreader.core.data.KoodoDatabase/2.json`).
+ *
+ * Room's instrumented MigrationTestHelper needs a device; this test runs the
+ * same SQL on a plain JDBC connection instead (pure JVM, no Android SDK).
+ */
+class KoodoMigrationsTest {
+
+    /** Creates the v1 shape in [db]: the five desktop tables, no history table. */
+    private fun v1Shape(db: Connection) {
+        db.createStatement().use { st ->
+            st.execute(
+                "CREATE TABLE \"books\" (\"key\" TEXT NOT NULL, \"name\" TEXT, \"author\" TEXT, " +
+                    "\"description\" TEXT, \"md5\" TEXT, \"cover\" TEXT, \"format\" TEXT, " +
+                    "\"publisher\" TEXT, \"size\" INTEGER, \"page\" INTEGER, \"path\" TEXT, " +
+                    "\"charset\" TEXT, PRIMARY KEY(\"key\"))",
+            )
+            for (t in listOf("notes", "bookmarks", "plugins", "words")) {
+                st.execute("CREATE TABLE \"$t\" (\"key\" TEXT NOT NULL PRIMARY KEY, \"payload\" TEXT)")
+            }
+        }
+        db.createStatement().use { it.execute("PRAGMA user_version = 1") }
+    }
+
+    private fun Connection.applyMigration() {
+        KoodoMigrations.MIGRATION_1_2_SQL.forEach { sql ->
+            createStatement().use { it.execute(sql) }
+        }
+        createStatement().use { it.execute("PRAGMA user_version = 2") }
+    }
+
+    private fun Connection.exec(sql: String) {
+        createStatement().use { it.execute(sql) }
+    }
+
+    private fun Connection.queryLong(sql: String): Long =
+        createStatement().use { st ->
+            st.executeQuery(sql).use { rs ->
+                check(rs.next()) { "no row for: $sql" }
+                rs.getLong(1)
+            }
+        }
+
+    private fun Connection.insertHistory(key: String, i: Int) {
+        prepareStatement(
+            "INSERT INTO translation_history (`key`, sourceText, translatedText, sourceLang, " +
+                "targetLang, provider, bookKey, cfi, createdAt) VALUES (?,?,?,?,?,?,?,?,?)",
+        ).use { ps ->
+            ps.setString(1, key)
+            ps.setString(2, "hello $i")
+            ps.setString(3, "你好 $i")
+            ps.setString(4, "en")
+            ps.setString(5, "zh-CN")
+            ps.setString(6, "google")
+            ps.setString(7, "bk-$i")
+            ps.setString(8, "epubcfi(/6/4)")
+            ps.setLong(9, 1_700_000_000_000L + i)
+            ps.executeUpdate()
+        }
+    }
+
+    // ------------------------------------------------------------- tests
+
+    @Test
+    fun `empty v1 database migrates and gains a usable history table`() {
+        DriverManager.getConnection("jdbc:sqlite::memory:").use { db ->
+            v1Shape(db)
+            assertEquals(1L, db.queryLong("PRAGMA user_version"))
+            db.applyMigration()
+            assertEquals(2L, db.queryLong("PRAGMA user_version"))
+            assertEquals(0L, db.queryLong("SELECT COUNT(*) FROM translation_history"))
+            db.insertHistory("k1", 1)
+            assertEquals(1L, db.queryLong("SELECT COUNT(*) FROM translation_history"))
+        }
+    }
+
+    @Test
+    fun `v1 data survives the migration verbatim`() {
+        DriverManager.getConnection("jdbc:sqlite::memory:").use { db ->
+            v1Shape(db)
+            db.exec("INSERT INTO books (\"key\", name, md5) VALUES ('bk1', 'My Book', 'abc123')")
+            db.exec("INSERT INTO notes (\"key\", payload) VALUES ('n1', 'keep me')")
+
+            db.applyMigration()
+
+            db.createStatement().use { st ->
+                st.executeQuery("SELECT name, md5 FROM books WHERE \"key\" = 'bk1'").use { rs ->
+                    check(rs.next())
+                    assertEquals("My Book", rs.getString(1))
+                    assertEquals("abc123", rs.getString(2))
+                }
+                st.executeQuery("SELECT payload FROM notes WHERE \"key\" = 'n1'").use { rs ->
+                    check(rs.next())
+                    assertEquals("keep me", rs.getString(1))
+                }
+            }
+            assertEquals(0L, db.queryLong("SELECT COUNT(*) FROM translation_history"))
+        }
+    }
+
+    @Test
+    fun `migrated table round-trips rows with the entity column set`() {
+        DriverManager.getConnection("jdbc:sqlite::memory:").use { db ->
+            v1Shape(db)
+            db.applyMigration()
+            for (i in 1..500) db.insertHistory("k-$i", i)
+            assertEquals(500L, db.queryLong("SELECT COUNT(*) FROM translation_history"))
+            db.createStatement().use { st ->
+                st.executeQuery(
+                    "SELECT `key`, sourceText FROM translation_history " +
+                        "ORDER BY createdAt DESC LIMIT 1",
+                ).use { rs ->
+                    check(rs.next())
+                    assertEquals("k-500", rs.getString(1))
+                    assertEquals("hello 500", rs.getString(2))
+                }
+            }
+        }
+    }
+
+    @Test
+    fun `migrated schema matches the room entity definition`() {
+        DriverManager.getConnection("jdbc:sqlite::memory:").use { db ->
+            v1Shape(db)
+            db.applyMigration()
+            db.createStatement().use { st ->
+                st.executeQuery("PRAGMA table_info(translation_history)").use { rs ->
+                    val cols = mutableListOf<String>()
+                    var keyNotNull = false
+                    while (rs.next()) {
+                        cols.add(rs.getString("name"))
+                        if (rs.getString("name") == "key" && rs.getInt("notnull") == 1) keyNotNull = true
+                    }
+                    assertEquals(
+                        listOf(
+                            "key", "sourceText", "translatedText", "sourceLang",
+                            "targetLang", "provider", "bookKey", "cfi", "createdAt",
+                        ),
+                        cols,
+                    )
+                    assertTrue(keyNotNull, "`key` must be NOT NULL (Room PK)")
+                }
+            }
+            assertEquals(
+                3L,
+                db.queryLong(
+                    "SELECT COUNT(*) FROM sqlite_master WHERE type = 'index' " +
+                        "AND tbl_name = 'translation_history' AND name NOT LIKE 'sqlite_autoindex%'",
+                ),
+            )
+        }
+    }
+
+    @Test
+    fun `migration statements are ordered table-first then indices`() {
+        assertTrue(KoodoMigrations.MIGRATION_1_2_SQL.first().startsWith("CREATE TABLE"))
+        assertTrue(KoodoMigrations.MIGRATION_1_2_SQL.drop(1).all { it.startsWith("CREATE INDEX") })
+        assertFalse(KoodoMigrations.MIGRATION_1_2_SQL.isEmpty())
+    }
+}
