@@ -0,0 +1,41 @@
+package com.koodoreader.core.data
+
+import androidx.room.migration.Migration
+import androidx.sqlite.db.SupportSQLiteDatabase
+
+/**
+ * KoodoDatabase schema migrations.
+ *
+ * `MIGRATION_1_2` (P6-TRANS-DB): adds the Android-owned
+ * `translation_history` table (merged from `:feature:translate`'s standalone
+ * `koodo_translation_history.db`). Purely additive — the five desktop tables
+ * are untouched, so v1 data survives verbatim. The SQL is EXACTLY what Room
+ * derives from [TranslationHistoryEntity] (verified against the exported
+ * `schemas/…/2.json` by `KoodoMigrationsTest`); keep the two in lock-step.
+ */
+object KoodoMigrations {
+
+    /** The CREATE statements of `MIGRATION_1_2`, in execution order. */
+    val MIGRATION_1_2_SQL: List<String> = listOf(
+        "CREATE TABLE IF NOT EXISTS `" +
+            "translation_history` (`key` TEXT NOT NULL, `sourceText` TEXT NOT NULL, " +
+            "`translatedText` TEXT NOT NULL, `sourceLang` TEXT, `targetLang` TEXT NOT NULL, " +
+            "`provider` TEXT NOT NULL, `bookKey` TEXT, `cfi` TEXT, `createdAt` INTEGER NOT NULL, " +
+            "PRIMARY KEY(`key`))",
+        "CREATE INDEX IF NOT EXISTS `index_translation_history_createdAt` " +
+            "ON `translation_history` (`createdAt`)",
+        "CREATE INDEX IF NOT EXISTS `index_translation_history_bookKey` " +
+            "ON `translation_history` (`bookKey`)",
+        "CREATE INDEX IF NOT EXISTS `index_translation_history_provider` " +
+            "ON `translation_history` (`provider`)",
+    )
+
+    val MIGRATION_1_2: Migration = object : Migration(1, 2) {
+        override fun migrate(db: SupportSQLiteDatabase) {
+            MIGRATION_1_2_SQL.forEach(db::execSQL)
+        }
+    }
+
+    /** All migrations, for `Room.databaseBuilder(...).addMigrations(...)`. */
+    val ALL: Array<Migration> = arrayOf(MIGRATION_1_2)
+}
diff --git a/android/core/data/src/main/kotlin/com/koodoreader/core/data/dao/TranslationHistoryDao.kt b/android/core/data/src/main/kotlin/com/koodoreader/core/data/dao/TranslationHistoryDao.kt
