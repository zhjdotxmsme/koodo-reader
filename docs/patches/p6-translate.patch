+
+        assertEquals(
+            "https://api.cognitive.microsofttranslator.com/translate?api-version=3.0&to=zh-CN",
+            request.url,
+        )
+        assertTrue(request.headers.keys.none { it.equals(MicrosoftTranslateProvider.SUBSCRIPTION_REGION_HEADER, true) })
+    }
+
+    @Test
