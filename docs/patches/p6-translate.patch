+        assertEquals("""[{"text":"Hi there"}]""", request.body)
+        assertFalse(request.redactedDescription().contains(TestTokens.MICROSOFT))
+    }
+
+    @Test
+    fun `microsoft omits the from parameter and the region header when not set`() {
