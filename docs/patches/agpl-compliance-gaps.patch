diff --git a/android/app/src/main/java/com/koodoreader/reader/shell/AboutLicensesActivity.kt b/android/app/src/main/java/com/koodoreader/reader/shell/AboutLicensesActivity.kt
new file mode 100644
index 00000000..3e412734
--- /dev/null
+++ b/android/app/src/main/java/com/koodoreader/reader/shell/AboutLicensesActivity.kt
@@ -0,0 +1,132 @@
+package com.koodoreader.reader.shell
+
+import android.os.Bundle
+import android.view.ViewGroup
+import android.webkit.WebView
+import android.webkit.WebViewClient
+import android.widget.LinearLayout
+import android.widget.TextView
+import android.app.Activity
+import java.io.File
+
+/**
+ * About / open-source licenses page (AGPL-GAP, t-mufbb7em).
+ *
+ * AGPL §5(d) requires that interacting with users remotely through a
+ * computer network offers them the Corresponding Source; this activity
+ * makes the license texts physically reachable from inside the installed
+ * app:
+ *  - assets/COPYING   — the full GNU AGPL-3.0 text
+ *  - assets/NOTICE    — project + ported-upstream attribution
+ *  - assets/licenses/<lib>/LICENSE.txt — per vendored library
+ *
+ * Deliberately a plain `Activity` + WebView (no Compose dependency here):
+ * rendering the local markdown-free text files must work regardless of
+ * which UI track (native / WebView island) the user is on, and a WebView
+ * gives us wrapped, scrollable, zoomable text of a 34 KB license for free
+ * without pulling a markdown renderer. Assets are loaded via
+ * `file:///android_asset/` — no network access, no JS enabled.
+ */
+class AboutLicensesActivity : Activity() {
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val which = intent.getStringExtra(EXTRA_DOC) ?: DOC_NOTICE
+
+        val root = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            layoutParams = ViewGroup.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.MATCH_PARENT,
+            )
+        }
+
+        val title = TextView(this).apply {
+            text = titleFor(which)
+            textSize = 18f
+            setPadding(32, 32, 32, 16)
+        }
+        root.addView(
+            title,
+            LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT,
+            ),
+        )
+
+        val web = WebView(this).apply {
+            settings.javaScriptEnabled = false
+            settings.builtInZoomControls = true
+            settings.displayZoomControls = false
+            webViewClient = WebViewClient() // stay local; never leave the asset
+            setBackgroundColor(0x00000000)
+        }
+        // Load the resolved asset. For the licenses index we synthesize a
+        // tiny HTML from the manifest so each entry is directly readable.
+        when (which) {
+            DOC_LICENSES -> web.loadDataWithBaseURL(
+                "file:///android_asset/",
+                licensesIndexHtml(),
+                "text/html",
+                "utf-8",
+                null,
+            )
+            else -> web.loadUrl("file:///android_asset/$which")
+        }
+
+        root.addView(
+            web,
+            LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                0,
+                1f,
+            ),
+        )
+        setContentView(root)
+    }
+
+    /** Links every vendored library's LICENSE.txt into one tappable index. */
+    private fun licensesIndexHtml(): String {
+        val manifest = assets.open("licenses/manifest.json").bufferedReader().use { it.readText() }
+        // Minimal manifest parse (name list) without a JSON dependency: the
+        // manifest is machine-generated, one `"name": "..."` per lib.
+        val names = Regex("\"name\"\\s*:\\s*\"([^\"]+)\"").findAll(manifest)
+            .map { it.groupValues[1] }
+            .toList()
+            .distinct()
+        val items = names.joinToString("\n") { name ->
+            """<li><a href="licenses/$name/LICENSE.txt">$name</a></li>"""
+        }
+        val pending = if (manifest.contains("UNVERIFIED")) {
+            "<p><b>Note:</b> some entries are marked UNVERIFIED in the " +
+                "manifest — their license texts ship in the next release.</p>"
+        } else ""
+        return """<!DOCTYPE html><html><head><meta charset="utf-8">
+<title>Open-source licenses</title></head><body>
+<h3>Open-source licenses</h3>
+<p>Koodo Reader is AGPL-3.0. See <a href="COPYING">COPYING</a> for the
+full license and <a href="NOTICE">NOTICE</a> for upstream attribution.</p>
+$pending
+<ul>$items</ul>
+</body></html>"""
+    }
+
+    private fun titleFor(which: String): String = when (which) {
+        DOC_COPYING -> "GNU AGPL-3.0"
+        DOC_LICENSES -> "Open-source licenses"
+        else -> "NOTICE"
+    }
+
+    companion object {
+        const val EXTRA_DOC = "doc"
+        const val DOC_NOTICE = "NOTICE"
+        const val DOC_COPYING = "COPYING"
+        const val DOC_LICENSES = "licenses"
+    }
+}
+
+/** Small helper used by tests to confirm the license files ship. */
+fun licensesShipped(assetsDir: File): Boolean =
+    File(assetsDir, "COPYING").isFile &&
+        File(assetsDir, "NOTICE").isFile &&
+        File(assetsDir, "licenses/manifest.json").isFile
diff --git a/docs/adr/ADR-009-agpl-compliance.md b/docs/adr/ADR-009-agpl-compliance.md
new file mode 100644
index 00000000..3558a644
--- /dev/null
+++ b/docs/adr/ADR-009-agpl-compliance.md
@@ -0,0 +1,38 @@
+# ADR-009: AGPL §5(d) 合规交付（APK 内许可文本 + 关于页 + 第三方许可审计）
+
+- **Status**: accepted (2026-09-25)
+- **Card**: AGPL-GAP (t-mufbb7em-cyspbj)，依据 P8 附录 C（docs/appendix-c-agpl-compliance.md）的三个真实缺口
+- **编号说明**: ADR-008 预留给「字体适配」决策（卡 t-muew0ia6 收口时回填）；本 ADR 按卡内指定取 009
+
+## Context
+
+附录 C 审计结论：移植与再分发无法律障碍（全部上游为 AGPL-3.0 / MIT），但 Android 产物存在三个 §5(d)/§6 合规缺口：
+
+1. APK 内无 AGPL-3.0 全文（Corresponding Source 许可文本不可达）；
+2. 无应用内「关于 / 开源许可」入口；
+3. `public/lib` 的 17 个 vendored 第三方库无随包许可文本。
+
+## Decision
+
+1. **assets/COPYING** — 根 `LICENSE`（GNU AGPL-3.0 全文）逐字节随包。
+2. **assets/NOTICE** — 项目标识 + 移植上游归属（kookit / foliate-js / 桌面结构，逐项对应附录 C 证据表）+ 第三方库清单位置。
+3. **AboutLicensesActivity**（`:app`，普通 Activity + WebView 渲染本地资产）— 从应用内可达：
+   - `COPYING` / `NOTICE` / licenses 索引（由 manifest.json 合成，逐库链接 LICENSE.txt）。
+   - 禁 JS、仅 `file:///android_asset/`，无网络路径；不依赖任一 UI 轨（native 与兜底岛通用）。
+4. **assets/licenses/** — `manifest.json`（17 库：SPDX id / 主页 / 源仓库 / 文本文件）+ `_texts/`（LGPL-2.1、Apache-2.0、MIT、BSD-3-Clause、unRAR 的 verbatim 规范文本）+ 每库 `LICENSE.txt`（头信息 + 全文）。
+   - `esearch-ocr`、`kookit-css` 两项上游许可待人工核验，标 `UNVERIFIED` 占位并在 manifest notes 声明——**审计模式将其豁免但保持可见**，不放猜测的许可文本。
+   - 7z-wasm 记录 7-Zip LGPL-2.1 + unRAR 限制的双重义务。
+5. **scripts/copy-lib-licenses.js** — 重新生成 + `--check` 审计（public/lib 目录 ↔ manifest 全覆盖、文本文件非空、生成物逐字节一致，漂移 exit 2）。
+6. **CI 守卫** `.github/workflows/license-audit.yml` — push/PR 跑 `--check` 并断言 COPYING/NOTICE 存在。
+
+## Alternatives considered
+
+- **Gradle 插件自动生成第三方许可页（aboutlibraries 等）** — 只覆盖 Gradle/Maven 依赖，覆盖不了 vendored `public/lib` 的 wasm/css/js；且引入构建期网络与插件依赖。否决。
+- **许可文本构建期联网抓取** — 构建可复现性差、CI 网络策略冲突；改为「维护期抓取一次、入库提交、审计模式只比对」。
+- **仅外部链接到 GitHub** — §5(d) 关注的是与用户交互的可及性，离线可用（无网设备也要能看）才是稳妥口径。否决。
+
+## Consequences
+
+- 三个缺口闭环：COPYING/NOTICE 随包、应用内可达、17 库许可随包（15 项已验证，2 项 UNVERIFIED 挂账需人工核验后补文本）。
+- 新增 vendored 库时：manifest 加一条 + 跑 `copy-lib-licenses.js`，CI 审计自动拦截遗漏。
+- About 页入口当前由 native shell 调起；WebView 轨设置页后续接入同一 Activity（不影响合规状态——文本已随包可达）。
diff --git a/scripts/copy-lib-licenses.js b/scripts/copy-lib-licenses.js
new file mode 100644
index 00000000..865dd763
--- /dev/null
+++ b/scripts/copy-lib-licenses.js
@@ -0,0 +1,137 @@
+#!/usr/bin/env node
+// copy-lib-licenses.js — AGPL §5(d) companion: ship third-party license
+// texts for every vendored web lib under public/lib inside the Android app.
+//
+//   node scripts/copy-lib-licenses.js          # regenerate LICENSE.txt files
+//   node scripts/copy-lib-licenses.js --check  # audit, exit 0 or 2
+//
+// Sources of truth:
+//   android/app/src/main/assets/licenses/manifest.json  — one entry per lib
+//   android/app/src/main/assets/licenses/_texts/<id>.txt — verbatim texts
+// Generated:
+//   android/app/src/main/assets/licenses/<lib>/LICENSE.txt
+//
+// Checked per lib (--check):
+//   1. every directory in public/lib has a manifest entry
+//   2. every entry's textFile exists and is non-empty (UNVERIFIED entries
+//      are exempt; they ship a "text pending" placeholder instead)
+//   3. every LICENSE.txt matches regeneration byte-for-byte
+// Rationale: AGPL §5(d) requires complete corresponding source including
+// license texts for web libs shipped in the APK; any drift fails CI.
+'use strict';
+
+const fs = require('fs');
+const path = require('path');
+
+const ROOT = path.join(__dirname, '..');
+const PUBLIC_LIB = path.join(ROOT, 'public', 'lib');
+const LICENSES = path.join(
+  ROOT, 'android', 'app', 'src', 'main', 'assets', 'licenses',
+);
+const MANIFEST = path.join(LICENSES, 'manifest.json');
+const CHECK = process.argv.includes('--check');
+
+function fail(msg) {
+  console.error(`[copy-lib-licenses] ${msg}`);
+  process.exit(2);
+}
+
+const usage = () => {
+  console.log('Usage: node scripts/copy-lib-licenses.js [--check]');
+  console.log('  Regenerates (or audits) per-lib LICENSE.txt files under');
+  console.log('  android/app/src/main/assets/licenses/ from manifest.json.');
+};
+
+/** Render the LICENSE.txt content for one manifest entry. */
+function renderLicense(entry) {
+  const header =
+    `${entry.name}\n` +
+    `License: ${entry.license}\n` +
+    `Homepage: ${entry.homepage}\n` +
+    `Source: ${entry.sourceUrl}\n`;
+  if (!entry.textFile) {
+    // UNVERIFIED entry — never guess a license text.
+    return (
+      `${header}` +
+      `Text below (file: ${entry.textFile || '(none)'})\n` +
+      `LICENSE TEXT PENDING — see manifest.json\n`
+    );
+  }
+  const text = fs.readFileSync(path.join(LICENSES, entry.textFile), 'utf8');
+  return `${header}Text below (file: ${entry.textFile})\n${text}`;
+}
+
+function main() {
+  if (process.argv.includes('--help') || process.argv.includes('-h')) {
+    usage();
+    return;
+  }
+  if (!fs.existsSync(MANIFEST)) fail(`manifest not found: ${MANIFEST}`);
+  const manifest = JSON.parse(fs.readFileSync(MANIFEST, 'utf8'));
+  const byName = {};
+  for (const entry of manifest) byName[entry.name] = entry;
+
+  // 1. every directory in public/lib must have a manifest entry
+  const dirs = fs.readdirSync(PUBLIC_LIB).filter((d) =>
+    fs.statSync(path.join(PUBLIC_LIB, d)).isDirectory(),
+  );
+  for (const dir of dirs) {
+    if (!byName[dir]) {
+      fail(`no manifest entry for public/lib/${dir}`);
+    }
+  }
+
+  let verified = 0;
+  for (const entry of manifest) {
+    // 2. textFile exists and is non-empty (UNVERIFIED entries exempt)
+    if (entry.license === 'UNVERIFIED') {
+      console.log(
+        `[copy-lib-licenses] WARNING ${entry.name}: UNVERIFIED — needs human verification`,
+      );
+    } else {
+      verified++;
+      if (!entry.textFile) {
+        fail(`${entry.name}: license "${entry.license}" has no textFile`);
+      }
+      const textPath = path.join(LICENSES, entry.textFile);
+      if (!fs.existsSync(textPath)) {
+        fail(`${entry.name}: text file missing: ${entry.textFile}`);
+      }
+      if (fs.statSync(textPath).size === 0) {
+        fail(`${entry.name}: text file empty: ${entry.textFile}`);
+      }
+    }
+
+    const outDir = path.join(LICENSES, entry.name);
+    const outFile = path.join(outDir, 'LICENSE.txt');
+    const expected = renderLicense(entry);
