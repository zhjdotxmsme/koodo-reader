diff --git a/.github/workflows/license-audit.yml b/.github/workflows/license-audit.yml
new file mode 100644
index 00000000..8f6b1be1
--- /dev/null
+++ b/.github/workflows/license-audit.yml
@@ -0,0 +1,43 @@
+# name: License audit
+#
+# AGPL §5(d) 守卫:验证 public/lib 下所有第三方 web 库都随 APK 附带许可文本。
+#
+# 只用**官方 actions**(checkout / setup-node),不依赖第三方 action 仓库。
+#
+# 检查内容:
+#   - scripts/copy-lib-licenses.js --check:public/lib 每个目录都有 manifest 条目、
+#     许可文本存在且非空、生成的 LICENSE.txt 与重新生成逐字节一致
+#   - android/app/src/main/assets/ 下必须存在 COPYING 与 NOTICE
+
+name: License audit
+
+on:
+  push:
+    branches:
+      - dev
+      - main
+  pull_request:
+    branches:
+      - dev
+      - main
+
+jobs:
+  license-audit:
+    name: Audit third-party license texts
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup Node
+        uses: actions/setup-node@v4
+        with:
+          node-version: 18
+
+      - name: Check vendored lib license texts
+        run: node scripts/copy-lib-licenses.js --check
+
+      - name: Check COPYING and NOTICE exist
+        run: |
+          test -f android/app/src/main/assets/COPYING
+          test -f android/app/src/main/assets/NOTICE
diff --git a/android/app/src/main/AndroidManifest.xml b/android/app/src/main/AndroidManifest.xml
index fbf012f7..e8b492cf 100644
--- a/android/app/src/main/AndroidManifest.xml
+++ b/android/app/src/main/AndroidManifest.xml
@@ -146,6 +146,16 @@
             android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density"
             android:theme="@style/Theme.KoodoReader" />
 
+        <!--
+          AGPL-GAP (§5(d)): in-app about / open-source licenses page. Reads
+          assets/COPYING + assets/NOTICE + assets/licenses/* — never leaves
+          local assets. Not exported; opened from the native shell.
+        -->
+        <activity
+            android:name=".shell.AboutLicensesActivity"
+            android:exported="false"
+            android:theme="@style/Theme.KoodoReader" />
+
         <activity-alias
             android:name=".LauncherAlias"
             android:targetActivity="${nativeLauncher}"
