     implementation project(':engine:cfi')
--- a/android/app/src/main/AndroidManifest.xml
+++ b/android/app/src/main/AndroidManifest.xml
@@ -4,3 +4,18 @@
     <uses-permission android:name="android.permission.INTERNET" />
     <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
 
+    <!-- P6 TTS: keep speaking while the screen is off, and show the transport card. -->
+    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
+    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
+    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
+
+    <!--
+      Android 11+ package visibility: without this query,
+      EngineEnumerator's PackageManager.queryIntentActivities(TTS_SERVICE) sees only
+      the default engine, so the voice/engine picker would silently degrade.
+    -->
+    <queries>
+        <intent>
+            <action android:name="android.intent.action.TTS_SERVICE" />
+        </intent>
+    </queries>
@@ -127,3 +142,30 @@
             </intent-filter>
         </activity-alias>
+
+        <!--
+          P6 TTS: background listening (foreground service, mediaPlayback type) and
+          the lock-screen / media-key transport entry point. Both belong to
+          :feature:tts; the receiver filter mirrors
+          LockscreenControlsReceiver.ACTIONS (one table with TtsMediaCommandMapper).
+        -->
+        <service
+            android:name="com.koodoreader.feature.tts.ForegroundTtsService"
+            android:exported="false"
+            android:foregroundServiceType="mediaPlayback" />
+
+        <receiver
+            android:name="com.koodoreader.feature.tts.LockscreenControlsReceiver"
+            android:exported="true">
+            <intent-filter>
