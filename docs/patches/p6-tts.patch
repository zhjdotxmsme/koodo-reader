+                <action android:name="com.koodoreader.tts.action.PAUSE" />
+                <action android:name="com.koodoreader.tts.action.PLAY_PAUSE" />
+                <action android:name="com.koodoreader.tts.action.STOP" />
+                <action android:name="com.koodoreader.tts.action.NEXT" />
+                <action android:name="com.koodoreader.tts.action.PREVIOUS" />
+                <action android:name="com.koodoreader.tts.action.FAST_FORWARD" />
+                <action android:name="com.koodoreader.tts.action.REWIND" />
+            </intent-filter>
+        </receiver>
     </application>
