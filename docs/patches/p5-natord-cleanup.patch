+package com.koodoreader.engine.image
+
+import com.koodoreader.core.importer.ComicCover
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+
+/**
+ * P5-NATORD 防漂移守卫：`NaturalOrder` 是 `ComicCover.naturalComparator`
+ * 的薄委托——本测试钉死这一契约，任何"重新内联一份算法"或"上游语义变更
+ * 未同步"都会在此失败（页序必须与封面抽取/`books.page` 一致，P5-CBZ ADR §10）。
+ */
+class NaturalOrderTest {
+
+    @Test
+    fun `delegates to ComicCover naturalComparator on representative names`() {
+        val samples = listOf(
+            "page1" to "page2",
+            "page2" to "page10",        // 数值序：2 < 10
+            "p07" to "p7",              // 前导零更长者排前
+            "10.jpg" to "a.jpg",        // 数字在字母前
+            "PageB" to "pageb",         // 大小写不敏感相等 → 长度决胜
+            "a10b" to "a9c",            // 10 > 9
+        )
+        for ((a, b) in samples) {
+            assertEquals(
+                ComicCover.naturalComparator().compare(a, b),
+                NaturalOrder.compare(a, b),
+                "NaturalOrder($a,$b) drifted from ComicCover.naturalComparator",
+            )
+        }
+    }
+
+    @Test
+    fun `sorted extension uses the delegated comparator`() {
+        val names = listOf("page10", "page2", "page1")
+        assertEquals(listOf("page1", "page2", "page10"), NaturalOrder.sorted(names))
+    }
+
+    @Test
+    fun `ordering stays numeric-aware end to end`() {
+        val sorted = NaturalOrder.sorted(listOf("img_9.png", "img_10.png", "img_07.png"))
+        // 7 < 9 < 10 数值序（前导零不改变数值）
+        assertEquals(listOf("img_07.png", "img_9.png", "img_10.png"), sorted)
+    }
+}
